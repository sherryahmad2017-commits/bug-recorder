# The browser calls the API directly (bearer token, no cookies needed there).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# The Next.js server (route handlers under src/app/api/auth) also calls the
# API directly, from the server side, to set/read the httpOnly refresh cookie.
API_URL=http://localhost:4000/api/v1

# Must be "production" behind HTTPS in staging/prod so the refresh cookie gets Secure.
NODE_ENV=development
