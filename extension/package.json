{
  "name": "@reproflow/extension",
  "version": "0.1.0",
  "private": true,
  "description": "ReproFlow — Chrome extension (Manifest V3)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package-zip.mjs",
    "release": "npm run icons && npm run build && npm run package"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.21.5": true
  }
}
