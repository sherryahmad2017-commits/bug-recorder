# Copy to .env and fill in for local development.
# Local defaults below match infra/docker-compose.yml.

NODE_ENV=development
PORT=4000

# PostgreSQL (system of record)
DATABASE_URL=postgresql://reproflow:reproflow_dev_password@localhost:5432/reproflow?schema=public

# Redis (refresh-token store, rate limiting, BullMQ queues)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=reproflow-dev
STORAGE_ACCESS_KEY_ID=reproflow
STORAGE_SECRET_ACCESS_KEY=reproflow_dev_password
STORAGE_FORCE_PATH_STYLE=true

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-value-in-every-environment
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Dashboard origin allowed for CORS/CSRF
DASHBOARD_ORIGIN=http://localhost:3000

# Known extension ID(s) allowed to call the API, comma-separated (filled in once the
# extension is loaded unpacked / published — see extension/README.md)
EXTENSION_IDS=

# Envelope encryption key for integration OAuth tokens and AI provider keys (32-byte, base64)
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
